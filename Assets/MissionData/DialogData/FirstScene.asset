%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63fc6a8dcf668964590f30a42d177eb8, type: 3}
  m_Name: FirstScene
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Debt Collector
    text: YOU DONT CLOSE THAT! You owe my boss A LOT of money, buddy.
    lettersPerSecond: 25
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: We have been patient and want what is owed. Either you give me what is
      owed now or I break your legs!
    lettersPerSecond: 23
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Oh... You umm... Live like this?
    lettersPerSecond: 15
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Thats kind of... sad...
    lettersPerSecond: 14
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Since there is a job you could do for me, you have a chance to prove your
      worth.
    lettersPerSecond: 25
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: If you can show me you are worth more alive than dead, by bringing me a
      special book, I might let you live.
    lettersPerSecond: 25
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: There is an abandoned castle, still containing items. If you're lucky,
      you might find something.
    lettersPerSecond: 25
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
