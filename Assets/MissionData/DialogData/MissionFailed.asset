  lines:
  - speakerName: Debt Collector
    text: I'm here for something that wont make me sell you in little pieces.
    lettersPerSecond: 20
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Nothing..? Really? I had such high hopes for you.
