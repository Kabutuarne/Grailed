--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63fc6a8dcf668964590f30a42d177eb8, type: 3}
  m_Name: DialogData
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Debt Goon
    text: Hey, you know what i'm here for.
    lettersPerSecond: 25
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Goon
    text: By the way, seems I was a little wrong about the painting.
    lettersPerSecond: 20
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Goon
    text: Turns out he wants a dreadful painting. Something "haunted".
    lettersPerSecond: 25
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Next time i'm here you better have it, time is running out.
    lettersPerSecond: 22
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: By the way. Careful... There was some "movement" over there.
    lettersPerSecond: 20
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Not that you have a choice anyway.
    lettersPerSecond: 14
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
