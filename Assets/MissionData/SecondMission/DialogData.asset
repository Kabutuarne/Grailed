MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63fc6a8dcf668964590f30a42d177eb8, type: 3}
  m_Name: DialogData
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Debt Collector
    text: I'm here for something that wont make me sell you in little pieces.
    lettersPerSecond: 20
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Oh.. You actually have something...
    lettersPerSecond: 20
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: I did not think you had it in you. You might actually have some use.
    lettersPerSecond: 15
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: Head back over there and bring my boss a painting, he recently has gotten
      into art apperantly...
    lettersPerSecond: 14
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
  - speakerName: Debt Collector
    text: By the way I will be keeping that book.
    lettersPerSecond: 14
    talkingLoopClip: {fileID: 8300000, guid: c6aebad8a791b1b4284ec9e92331a321, type: 3}
