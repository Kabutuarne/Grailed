%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63fc6a8dcf668964590f30a42d177eb8, type: 3}
  m_Name: DialogData
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: Debt Goon
    text: You actually seem to be doing your job propperly!
    lettersPerSecond: 20
    talkingLoopClip: {fileID: 8300000, guid: ff3be4751973814409316a39a9e804dc, type: 3}
  - speakerName: Debt Collector
    text: Weird how you managed to rack up all of this debt...
    lettersPerSecond: 20
    talkingLoopClip: {fileID: 8300000, guid: 7e4fb32d10aff234b910c1506f88e592, type: 3}
  - speakerName: Debt Collector
    text: Anyway, I have a very urgent task for you.
    lettersPerSecond: 15
    talkingLoopClip: {fileID: 8300000, guid: ff3be4751973814409316a39a9e804dc, type: 3}
  - speakerName: Debt Collector
    text: Rumors of a powerful potion hidden in the expanding castle, which can heal
      any wound.
    lettersPerSecond: 14
    talkingLoopClip: {fileID: 8300000, guid: ff3be4751973814409316a39a9e804dc, type: 3}
  - speakerName: Debt Collector
    text: Since you seem quick on your feet, i need you to bring it back.
    lettersPerSecond: 14
    talkingLoopClip: {fileID: 8300000, guid: c9c0703d9ac8d464fa69cf7b57a91779, type: 3}
  - speakerName: Debt Collector
    text: And if you come empty handed, i will assume you drank it, in which case
      i will extract it out of your blood.
    lettersPerSecond: 14
    talkingLoopClip: {fileID: 8300000, guid: c9c0703d9ac8d464fa69cf7b57a91779, type: 3}
